# Copy to .env (gitignored). Shared by scripts/dev.sh and every agent.

# SpacetimeDB
# "local" (scripts/dev.sh starts a server) or "maincloud" (your spacetimedb.com account)
STDB_SERVER=local
STDB_DB=wildfire-rescue
# On maincloud database names are global: pick something unique, e.g. wildfire-rescue-<team>.
# Published into the module's environment; agents present it to register.
AGENT_JOIN_KEY=change-me-join-key
# Commander/responder login (web UI + ASI:One commander agent).
OPERATOR_PASSCODE=change-me-passcode

# Fetch.ai agents
# Agent addresses derive from this prefix. Keep it stable + secret, or anyone can impersonate your agents.
AGENT_SEED_PREFIX=change-me-long-random-string
# Agents that connect to Agentverse via mailbox (comma list, "all" or "none").
MAILBOX_AGENTS=intake,commander
AGENT_BASE_PORT=8100
# ASI:One @-handle prefix -> @<prefix>-intake, @<prefix>-commander (globally unique)
AGENT_HANDLE_PREFIX=
ASI1_API_KEY=
ASI1_MODEL=asi1-mini

# Data sources
# fire agent: sim | firms   (firms needs FIRMS_MAP_KEY from https://firms.modaps.eosdis.nasa.gov/api/map_key/)
FIRE_SOURCE=sim
FIRMS_MAP_KEY=
FIRMS_PRODUCT=VIIRS_SNPP_NRT
# Replay a past fire, e.g. FIRMS_PRODUCT=VIIRS_SNPP_SP FIRMS_DATE=2018-11-08 (Camp Fire). Empty = latest data.
FIRMS_DATE=
FIRMS_DAYS=1
# weather agent: nws (live wind, ignored while commander holds manual wind) | scenario
WEATHER_SOURCE=nws
WEATHER_POLL_S=300
NWS_USER_AGENT="wildfire-rescue-queue (you@example.com)"

# News agent: trusted wildfire accounts on X (CAL FIRE units, sheriffs / OES, NWS, Caltrans, Red Cross),
# read through Bright Data's pre-built X Posts scraper (Web Scraper API; billed per post returned)
#   file       = replay NEWS_FIXTURE (free, offline; default)
#   brightdata = run the X scraper: API key from brightdata.com/cp/setting/users -> "Add API key"
#   off        = disabled
NEWS_SOURCE=file
BRIGHTDATA_API_KEY=
# X (formerly Twitter) - Posts dataset: "Discover by profile url" for accounts, "Collect by URL" for single posts
BRIGHTDATA_X_DATASET_ID=gd_lwxkxvnf1cynvib9co
# Account registry (handle, kind, official, area covered); the agent follows the accounts near the incident
NEWS_SOURCES_FILE=news_sources.json
# Extra handles to always follow (comma list, no @), e.g. a local reporter or county page
NEWS_ACCOUNTS=
# Accounts per scrape, and newest posts per account (limit_per_input): a run bills up to their product
NEWS_MAX_ACCOUNTS=8
NEWS_POSTS_PER_ACCOUNT=20
# Place names that make a post relevant in live mode (an incident brings its own; the ping label and station
# names are added automatically)
NEWS_PLACES="Paradise,Magalia,Pentz,Concow,Chico,Butte County"
# WHERE = the latest ping_news(lat, lon, label); WHEN = the incident's window, or live: the last N hours
NEWS_LIVE_LOOKBACK_H=72
# A ping / time-window change pulls the accounts near it not yet on file for that window. 0 = manual only.
NEWS_FETCH_ON_PING=1
# With an incident selected, send its window as start_date/end_date on each profile input (format below).
# Only set 1 after confirming those input fields for "Discover by profile url" in the Bright Data dashboard.
NEWS_SEND_DATES=0
NEWS_DATE_FORMAT=%m-%d-%Y
# Raw scrapes are saved here (per incident) so a demo can replay without paying to scrape again.
NEWS_ARCHIVE_DIR=news_archive
# Seconds between scrapes when NEWS_AUTO_SCRAPE=1
NEWS_POLL_S=1800
# Bright Data bills every run. 0 = scrape only when asked ("refresh news"). Hard daily cap below.
NEWS_AUTO_SCRAPE=0
# One run <= NEWS_MAX_ACCOUNTS x NEWS_POSTS_PER_ACCOUNT posts (8 x 20 at $1.50/1k posts ~ $0.24)
NEWS_MAX_SCRAPES_PER_DAY=10
NEWS_FIXTURE=fixtures/news_sample.json

# RL (optional): TorchScript model for LearnedPolicy
# Dispatch policy the delegation agent runs: nearest | greedy | lookahead | learned.
# Dispatch policy: nearest | greedy | lookahead (heuristic placeholders from the design doc) | rl (the RL component:
# implement rescue/rl_policy.py, see docs/RL_INTEGRATION.md). The default keeps the pipeline running until rl is plugged in.
POLICY=lookahead
RL_POLICY_PATH=
