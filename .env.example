# Copy to .env (gitignored). Shared by scripts/dev.sh and every agent.

# SpacetimeDB
# "local" (scripts/dev.sh starts a server) or "maincloud" (your spacetimedb.com account)
STDB_SERVER=local
STDB_DB=wildfire-rescue
# On maincloud database names are global: pick something unique, e.g. wildfire-rescue-<team>.
# Published into the module's environment; agents present it to register.
AGENT_JOIN_KEY=change-me-join-key
# Commander/responder login (web UI + ASI:One commander agent).
OPERATOR_PASSCODE=change-me-passcode

# Fetch.ai agents
# Agent addresses derive from this prefix. Keep it stable + secret, or anyone can impersonate your agents.
AGENT_SEED_PREFIX=change-me-long-random-string
# Agents that connect to Agentverse via mailbox (comma list, "all" or "none").
MAILBOX_AGENTS=intake,commander
AGENT_BASE_PORT=8100
# ASI:One @-handle prefix -> @<prefix>-intake, @<prefix>-commander (globally unique)
AGENT_HANDLE_PREFIX=
ASI1_API_KEY=
ASI1_MODEL=asi1-mini

# Data sources
# fire agent: sim | firms   (firms needs FIRMS_MAP_KEY from https://firms.modaps.eosdis.nasa.gov/api/map_key/)
FIRE_SOURCE=sim
FIRMS_MAP_KEY=
FIRMS_PRODUCT=VIIRS_SNPP_NRT
# Replay a past fire, e.g. FIRMS_PRODUCT=VIIRS_SNPP_SP FIRMS_DATE=2018-11-08 (Camp Fire). Empty = latest data.
FIRMS_DATE=
FIRMS_DAYS=1
# weather agent: nws (live wind, ignored while commander holds manual wind) | scenario
WEATHER_SOURCE=nws
WEATHER_POLL_S=300
NWS_USER_AGENT="wildfire-rescue-queue (you@example.com)"

# News agent (Bright Data Scraper Studio)
#   file       = replay NEWS_FIXTURE (free, offline; default)
#   brightdata = run your collector: API key from brightdata.com/cp/setting/users -> "Add API key";
#                collector id (c_...) from brightdata.com/cp/scrapers (save the scraper to production first)
#   off        = disabled
NEWS_SOURCE=file
BRIGHTDATA_API_KEY=
BRIGHTDATA_COLLECTOR_ID=
NEWS_KEYWORDS="wildfire,evacuation,road closure"
NEWS_LOCATION="Paradise California"
# Place names that make an article relevant to this incident (station names are added automatically)
NEWS_PLACES="Paradise,Magalia,Pentz,Concow,Chico,Butte County"
# Seconds between scrapes (each run costs page loads; ~2 per keyword)
# Send date_from/date_to to the collector. Only set 1 after declaring those inputs in Scraper Studio (undeclared inputs -> HTTP 422).
NEWS_SEND_DATES=0
# Raw scrapes are saved here (per incident) so a demo can replay without paying to scrape again.
NEWS_ARCHIVE_DIR=news_archive
NEWS_POLL_S=1800
NEWS_FIXTURE=fixtures/brightdata_cnn_sample.json

# RL (optional): TorchScript model for LearnedPolicy
# Dispatch policy the delegation agent runs: nearest | greedy | lookahead | learned.
# Dispatch policy: nearest | greedy | lookahead (heuristic placeholders from the design doc) | rl (the RL component:
# implement rescue/rl_policy.py, see docs/RL_INTEGRATION.md). The default keeps the pipeline running until rl is plugged in.
POLICY=lookahead
RL_POLICY_PATH=
