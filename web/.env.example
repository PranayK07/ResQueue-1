# Optional. Copy to web/.env.local (gitignored). Only VITE_* variables reach the browser.

# live (default): the SpacetimeDB backend. sim: Sharon's in-browser simulation, no backend needed.
VITE_DATA_SOURCE=live

# Replay presentation and responder GPS suppression. Callers always start in the incident area without GPS.
# The caller map shows only their location; fire/exposure layers are on operational screens.
VITE_DEMO_MODE=false

# Where the live app connects. By default it follows the repo-root .env, like scripts/dev.sh and the agents:
# STDB_HTTP, else STDB_SERVER (local -> ws://127.0.0.1:3000, maincloud -> wss://maincloud.spacetimedb.com),
# and STDB_DB (default wildfire-rescue). Set these only to point the web app somewhere else.
# VITE_STDB_URI=ws://127.0.0.1:3000
# VITE_STDB_DB=wildfire-rescue
