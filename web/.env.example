# Copy to .env.local (gitignored). Only VITE_* vars reach the browser.
# SpacetimeDB: local sandbox by default; point these at the hosted database for the demo.
VITE_STDB_URI=ws://127.0.0.1:3000
VITE_STDB_DB=wildfire-rescue
# Vector map style. CARTO Dark Matter needs no key; keep its attribution visible.
VITE_MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json
# Optional Claude intake endpoint (POST /api/intake). Empty = manual fields only.
VITE_INTAKE_URL=
